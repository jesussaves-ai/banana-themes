{
  // Retroism: a Windows 95 desktop for BananaOS, matching a niri + Quickshell "Retroism" system.
  //
  // Palette and chrome are Chicago95 (https://github.com/grassmunk/Chicago95), GPL-3.0+: face #c0c0c0,
  // highlight #ffffff, shadow #808080, outline #000000, navy #000080 for active title bars and selections
  // (#ffffff on them), hover #dfdfdf. Corners are square; depth is only the bevels. The taskbar layout is the
  // Retroism shell's. The desktop is the author's metropolis wallpaper (retroism/wallpaper.png), with a scrim.
  // The text is Chicago95's DOS VGA font (retroism/MorePerfectDOSVGA.ttf, GPL-3.0+); MS Sans Serif, Monaco and
  // Charcoal can't be redistributed. See README.md for the credits.
  "name": "Retroism",
  "author": "niri + Quickshell, on Chicago95 (GPL-3.0+)",
  "base": "light",
  "accent": "#000080",

  "colors": {
    "screenBg": "#c0c0c0", "screenBand": "#ffffff", "screenFrame": "#000000",
    "ink": "#000000", "muted": "#404040", "line": "#808080", "edge": "#000000", "navy": "#000080",
    "panelBand": "#ffffff", "panelBody": "#c0c0c0", "panelLow": "#808080",
    "chipBand": "#ffffff", "chipBody": "#c0c0c0",
    "bubbleBand": "#ffffff", "bubbleBody": "#c0c0c0", "bubbleLow": "#808080",
    "sheetBase": "#c0c0c0", "sheetHi": "#ffffff", "sheetLo": "#808080",
    "trackBg": "#c0c0c0", "trackHi": "#ffffff", "trackShade": "#808080", "railBg": "#c0c0c0",
    "slotOn": "#000080", "onPick": "#ffffff", "onPickAccent": "#ffffff",
    "meterBg": "#808080", "rule": "#808080",
    "kbdBg": "#ffffff", "kbdInk": "#000000",
    "favBorder": "#000080", "favBand": "#ffffff", "favBody": "#c0c0c0", "favInk": "#000000",
    "floor": "#00000055", "glint": "#ffffff66",
    "blackish": "#000000", "shade35": "#00000059", "shade40": "#00000066", "shade45": "#00000073"
  },
  "font": "dos",
  // the DOS VGA font Chicago95 ships (GPL-3.0+/MIT); regular/medium are also Settings' fonts
  "fonts": { "regular": "retroism/MorePerfectDOSVGA.ttf", "medium": "retroism/MorePerfectDOSVGA.ttf",
             "dos": "retroism/MorePerfectDOSVGA.ttf" },

  "vars": {
    "face": "#c0c0c0", "hi": "#ffffff", "sh": "#808080", "well": "#c0c0c0", "hover": "#dfdfdf",
    "ink": "#000000", "dim": "#404040", "acc": "#000080", "urgent": "#ff0000", "navy": "#000080",
    "paper": "#ffffff", "mono": "dos"
  },

  "input": {
    "home": { "left": "prev", "right": "next", "up": "prev", "down": "next" },
    "library": { "up": "prev", "down": "next", "left": "prev:4", "right": "next:4" }
  },
  "hints": {
    "home": [["A", "Open"], ["X", "Resume"], ["Y", "Favourite"]],
    "library": [["A", "Play"], ["B", "Back"], ["Y", "Favourite"]]
  },
  "behavior": { "launchMs": 800, "scrollMs": 40, "settleMs": 120, "cues": { "insert": 500 } },

  "components": {
    // the desktop: a dark blue-grey gradient with a low skyline, as the wallpaper behind everything
    "wallpaper": {
      "type": "group",
      "children": [
        // a real picture behind everything: the author's wallpaper, 1024x768, in the theme's own folder
        { "type": "image", "src": "retroism/wallpaper.png", "fit": "cover", "x": 0, "y": 0, "w": "100%", "h": "100%", "placeholder": "#2f4058" },
        // a light scrim over it, so the desktop icons and the windows stay readable
        { "type": "rect", "x": 0, "y": 0, "w": "100%", "h": "100%", "fill": "#0e141c4d" }
      ]
    },

    // a raised 3D plate: black edge, face, white top/left, shadow bottom/right (square corners)
    "raised": {
      "type": "group",
      "children": [
        { "type": "rect", "fill": "=ink" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "bottom": 1, "fill": "=face" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "h": 2, "fill": "=hi" },
        { "type": "rect", "x": 1, "y": 1, "bottom": 1, "w": 2, "fill": "=hi" },
        { "type": "rect", "x": 1, "bottom": 1, "right": 1, "h": 2, "fill": "=sh" },
        { "type": "rect", "right": 1, "y": 1, "bottom": 1, "w": 2, "fill": "=sh" }
      ]
    },

    // a sunken well: the bevel inverted, in the darker grey
    "sunken": {
      "type": "group",
      "children": [
        { "type": "rect", "fill": "=ink" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "bottom": 1, "fill": "=well" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "h": 2, "fill": "=sh" },
        { "type": "rect", "x": 1, "y": 1, "bottom": 1, "w": 2, "fill": "=sh" },
        { "type": "rect", "x": 1, "bottom": 1, "right": 1, "h": 2, "fill": "=hi" },
        { "type": "rect", "right": 1, "y": 1, "bottom": 1, "w": 2, "fill": "=hi" }
      ]
    },

    // a sunken document/client area, in paper white
    "client": {
      "type": "group",
      "children": [
        { "type": "rect", "fill": "=ink" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "bottom": 1, "fill": "=paper" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "h": 1, "fill": "=sh" },
        { "type": "rect", "x": 1, "y": 1, "bottom": 1, "w": 1, "fill": "=sh" },
        { "type": "rect", "x": 1, "bottom": 1, "right": 1, "h": 1, "fill": "=hi" },
        { "type": "rect", "right": 1, "y": 1, "bottom": 1, "w": 1, "fill": "=hi" }
      ]
    },

    // a selectable plate: raised at rest, sunken (in the well) when it is the selection
    "plate": {
      "type": "group",
      "children": [
        { "type": "rect", "fill": "=ink" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "bottom": 1, "fill": "=sel ? well : face" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "h": 2, "fill": "=sel ? sh : hi" },
        { "type": "rect", "x": 1, "y": 1, "bottom": 1, "w": 2, "fill": "=sel ? sh : hi" },
        { "type": "rect", "x": 1, "bottom": 1, "right": 1, "h": 2, "fill": "=sel ? hi : sh" },
        { "type": "rect", "right": 1, "y": 1, "bottom": 1, "w": 2, "fill": "=sel ? hi : sh" }
      ]
    },

    // a window: the grey frame, a navy title bar (title in "title") and its minimise/maximise/close boxes
    "window": {
      "type": "group",
      "children": [
        { "type": "rect", "fill": "=ink" },
        { "type": "rect", "x": 2, "y": 2, "right": 2, "bottom": 2, "fill": "=face" },
        { "type": "rect", "x": 2, "y": 2, "right": 2, "h": 2, "fill": "=hi", "z": -1 },
        { "type": "rect", "x": 2, "y": 2, "bottom": 2, "w": 2, "fill": "=hi" },
        { "type": "rect", "x": 2, "bottom": 2, "right": 2, "h": 2, "fill": "=sh" },
        { "type": "rect", "right": 2, "y": 2, "bottom": 2, "w": 2, "fill": "=sh" },
        { "type": "group", "x": 6, "y": 6, "right": 6, "h": 25, "children": [
          { "type": "rect", "fill": "=navy" },
          { "type": "text", "x": 8, "y": 4, "right": 74, "align": "center", "text": "{title}", "font": "=mono", "size": 15, "color": "#ffffff" },
          // the Windows 95 title-bar buttons: minimise, maximise, close (drawn for the look; they do nothing)
          { "type": "group", "right": 49, "y": 2, "w": 20, "h": 20, "children": [
            { "use": "raised" },
            { "type": "rect", "x": 6, "y": 13, "w": 9, "h": 3, "fill": "=ink" } ] },
          { "type": "group", "right": 26, "y": 2, "w": 20, "h": 20, "children": [
            { "use": "raised" },
            { "type": "rect", "x": 5, "y": 5, "w": 11, "h": 10, "fill": "=ink" },
            { "type": "rect", "x": 6, "y": 8, "w": 9, "h": 6, "fill": "=face" } ] },
          { "type": "group", "right": 3, "y": 2, "w": 20, "h": 20, "children": [
            { "use": "raised" },
            { "type": "text", "x": 0, "w": "100%", "y": 1, "h": "100%", "align": "center", "valign": "middle", "text": "X", "size": 14, "color": "=ink" } ] }
        ] }
      ]
    },

    // a status strip: the hint buttons and what they do
    "statusbar": {
      "type": "group",
      "children": [
        { "type": "rect", "fill": "=ink" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "bottom": 1, "fill": "=face" },
        { "type": "list", "source": "hints", "direction": "row", "flow": true, "gap": 16, "scrollMode": "none", "x": 9, "y": 5, "w": "100%", "h": 22,
          "item": { "type": "group", "layout": "row", "gap": 6, "align": "center", "h": 22, "children": [
            { "type": "group", "w": "=11 + 9 * len(item.key)", "h": 20, "children": [
              { "use": "raised" },
              { "type": "text", "x": 0, "w": "100%", "y": 1, "h": "100%", "align": "center", "valign": "middle", "text": "{item.key}", "size": 14, "color": "=ink" } ] },
            { "type": "text", "text": "{item.label}", "size": 15, "color": "=ink" } ] } }
      ]
    },

    // the left pane of a window: a heading and three lines (its text comes from "with")
    "tasks": {
      "type": "group",
      "children": [
        { "type": "rect", "fill": "=ink" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "bottom": 1, "fill": "=face" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "h": 2, "fill": "=hi" },
        { "type": "rect", "x": 1, "y": 1, "bottom": 1, "w": 2, "fill": "=hi" },
        { "type": "rect", "x": 1, "bottom": 1, "right": 1, "h": 2, "fill": "=sh" },
        { "type": "rect", "right": 1, "y": 1, "bottom": 1, "w": 2, "fill": "=sh" },
        { "type": "group", "x": 6, "y": 6, "right": 6, "h": 27, "children": [
          { "type": "rect", "fill": "=ink" },
          { "type": "rect", "x": 1, "y": 1, "right": 1, "bottom": 1, "fill": "=well" },
          { "type": "rect", "x": 1, "y": 1, "right": 1, "h": 1, "fill": "=sh" },
          { "type": "rect", "x": 1, "bottom": 1, "right": 1, "h": 1, "fill": "=hi" },
          { "type": "text", "x": 8, "y": 4, "text": "{heading}", "font": "=mono", "size": 15, "color": "=ink" }
        ] },
        { "type": "text", "x": 9, "y": 48, "w": 138, "text": "{line1}", "size": 14, "color": "=ink", "wrap": true },
        { "type": "text", "x": 9, "y": 84, "w": 138, "text": "{line2}", "size": 14, "color": "=ink", "wrap": true },
        { "type": "text", "x": 9, "y": 120, "w": 138, "text": "{line3}", "size": 14, "color": "=ink", "wrap": true }
      ]
    },

    // one fact: a grey label over its value
    "fact": {
      "type": "group", "layout": "column", "gap": 2,
      "children": [
        { "type": "text", "text": "{label}", "size": 14, "color": "=dim" },
        { "type": "text", "text": "{value}", "font": "=mono", "size": 19, "color": "=ink" }
      ]
    }
  },

  "screens": {
    // the Retroism panel, along the top of every view
    "all": {
      "top": {
        "type": "group", "x": 0, "y": 0, "w": "100%", "h": 35,
        "children": [
        { "type": "rect", "fill": "=ink" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "bottom": 1, "fill": "=face" },
        { "type": "rect", "x": 1, "y": 1, "right": 1, "h": 1, "fill": "=hi" },
        { "type": "rect", "x": 1, "bottom": 1, "right": 1, "h": 2, "fill": "=sh" },
        // the "start" chip
        { "type": "group", "x": 5, "y": 5, "w": 100, "h": 25, "children": [
          { "use": "raised" },
          { "type": "group", "x": 8, "y": 7, "w": 13, "h": 13, "children": [
            { "type": "rect", "w": 7, "h": 7, "fill": "#ff0000" },
            { "type": "rect", "x": 8, "w": 5, "h": 7, "fill": "#00a000" },
            { "type": "rect", "y": 8, "w": 7, "h": 5, "fill": "#0000c0" },
            { "type": "rect", "x": 8, "y": 8, "w": 5, "h": 5, "fill": "#ffd000" }
          ] },
          { "type": "text", "x": 28, "y": 4, "text": "BANANA", "font": "=mono", "size": 15, "color": "=ink" }
        ] },
        // what is open, in a sunken cell (waybar's #window)
        { "type": "group", "x": 114, "y": 5, "w": 326, "h": 25, "children": [
          { "use": "sunken" },
          { "type": "text", "x": 8, "y": 4, "w": 310, "text": "=view == 'home' ? sys.name : game.title", "font": "=mono", "size": 15, "color": "=ink" }
        ] },
        // the tray: Wi-Fi, battery, clock
        { "type": "group", "right": 170, "y": 5, "w": 26, "h": 26, "children": [
          { "use": "raised" },
          // the Wi-Fi signal: four bars, black when it is up, pale when it is down
          { "type": "rect", "x": 5, "y": 15, "w": 3, "h": 5, "fill": "=online ? ink : '#a8a8a8'" },
          { "type": "rect", "x": 9, "y": 12, "w": 3, "h": 8, "fill": "=online ? ink : '#a8a8a8'" },
          { "type": "rect", "x": 13, "y": 9, "w": 3, "h": 11, "fill": "=online ? ink : '#a8a8a8'" },
          { "type": "rect", "x": 17, "y": 6, "w": 3, "h": 14, "fill": "=online ? ink : '#a8a8a8'" }
        ] },
        { "type": "group", "right": 94, "y": 5, "w": 72, "h": 25, "children": [
          { "use": "sunken" },
          { "type": "rect", "x": 7, "y": 8, "w": 20, "h": 10, "border": 1, "borderColor": "=ink", "visible": "=battery >= 0" },
          { "type": "rect", "x": 9, "y": 10, "w": "=16 * battery / 100", "h": 6, "fill": "=battery < 20 ? urgent : acc", "visible": "=battery >= 0" },
          { "type": "text", "right": 5, "y": 4, "w": 38, "align": "right", "text": "=battery < 0 ? '' : battery", "font": "=mono", "size": 15, "color": "=ink" }
        ] },
        { "type": "group", "right": 4, "y": 5, "w": 86, "h": 25, "children": [
          { "use": "sunken" },
          { "type": "text", "x": 0, "w": "100%", "y": 4, "align": "center", "text": "{clock}", "font": "=mono", "size": 15, "color": "=ink" }
        ] }
        ]
      }
    },

    "home": {
      "top": [
        { "use": "wallpaper" },
        { "use": "window", "x": 40, "y": 36, "w": 560, "h": 372, "with": { "title": "{sys.name}" } },
        { "use": "tasks", "x": 52, "y": 72, "w": 150, "h": 324,
          "with": { "heading": "System", "line1": "=sys.app ? 'Start this app' : 'Open the games'",
                    "line2": "=sys.hasResume ? 'Resume the last game' : 'No game in progress'",
                    "line3": "=sys.fav ? 'Remove from favourites' : 'Add to favourites'" } },
        { "use": "client", "x": 210, "y": 72, "w": 372, "h": 324 },
        { "type": "image", "src": "{sys.icon}", "fit": "pixelContain", "x": 228, "y": 88, "w": 114, "h": 114,
          "scale": "=0.85 + 0.15 * easeOutBack(progress(moved, 220))", "anchor": "top left" },
        { "type": "text", "x": 352, "y": 90, "w": 226, "text": "{sys.name}", "font": "=mono", "size": 28, "color": "=ink", "wrap": true, "maxLines": 2 },
        { "type": "text", "x": 352, "y": 166, "w": 226, "text": "{upper(sys.maker)}", "size": 15, "color": "=dim" },
        { "type": "rect", "x": 228, "y": 216, "w": 342, "h": 1, "fill": "=sh" },
        { "type": "group", "x": 228, "y": 228, "w": 342, "h": 60, "layout": "row", "gap": 38, "children": [
          { "use": "fact", "with": { "label": "Games", "value": "=sys.app ? 'App' : str(sys.games)" } },
          { "use": "fact", "with": { "label": "Played", "value": "{sys.played}" } },
          { "use": "fact", "with": { "label": "Time", "value": "=either(sys.time, '0m')" } } ] },
        { "type": "group", "x": 228, "y": 292, "w": 342, "h": 100, "visible": "=sys.hasResume", "children": [
          { "type": "text", "text": "{either(sys.resumeEyebrow, 'Last played')}", "size": 14, "color": "=dim" },
          { "type": "image", "src": "{sys.resumeArt}", "fallback": "{sys.icon}", "fit": "contain", "x": 0, "y": 16, "w": 80, "h": 80, "placeholder": "=well" },
          { "type": "text", "x": 92, "y": 28, "w": 250, "text": "{sys.resumeTitle}", "font": "=mono", "size": 18, "color": "=ink" },
          { "type": "text", "x": 92, "y": 56, "w": 250, "text": "Press X to resume", "size": 15, "color": "=navy" } ] },
        { "use": "statusbar", "x": 40, "y": 412, "w": 560, "h": 32 }
      ],
      "bottom": [
        { "use": "wallpaper" },
        // the desktop icons: the systems as a grid of shortcuts, four to a row
        { "type": "list", "source": "systems", "direction": "grid", "columns": 4, "x": 12, "y": 12, "w": 616, "h": 428,
          "itemW": 148, "itemH": 104, "gap": 8, "scrollMode": "edge", "clip": true,
          "item": {
            "type": "group", "w": 148, "h": 104,
            "children": [
              { "type": "image", "src": "{item.icon}", "fit": "pixelContain", "x": 45, "y": 6, "w": 58, "h": 58,
                "scale": "=sel ? 1.15 : 1.0" },
              { "type": "group", "x": 74, "y": 68, "anchor": "top", "layout": "row", "padding": 2,
                "fill": "=sel ? navy : '#00000000'",
                "children": [ { "type": "text", "text": "{item.name}", "size": 14, "color": "=sel ? '#ffffff' : '#eef2f7'",
                  "shadow": { "x": 1, "y": 1, "color": "=sel ? '#00000000' : '#000000c0'" } } ] },
              { "type": "group", "x": 88, "y": 6, "w": 15, "h": 15, "fill": "=paper", "border": 1, "borderColor": "=ink",
                "visible": "=item.fav", "children": [
                { "type": "text", "x": 0, "w": 15, "y": -4, "align": "center", "text": "*", "font": "=mono", "size": 14, "color": "=navy" } ] }
            ]
          } },
        // the count, in a sunken cell at the bottom right
        { "type": "group", "right": 10, "y": 452, "w": 140, "h": 24, "children": [
          { "use": "sunken" },
          { "type": "text", "x": 0, "w": "100%", "y": 4, "align": "center", "text": "{cursor + 1} of {count}", "font": "=mono", "size": 15, "color": "=ink" }
        ] }
      ]
    },

    "library": {
      "top": [
        { "use": "wallpaper" },
        { "use": "window", "x": 40, "y": 36, "w": 560, "h": 372, "with": { "title": "{game.title}" } },
        { "use": "tasks", "x": 52, "y": 72, "w": 150, "h": 324,
          "with": { "heading": "Game", "line1": "Play this game", "line2": "=game.fav ? 'Remove from favourites' : 'Add to favourites'", "line3": "Back to the systems" } },
        { "use": "client", "x": 210, "y": 72, "w": 372, "h": 324 },
        { "type": "text", "x": 220, "w": 352, "y": 190, "align": "center", "visible": "=empty", "text": "{empty.title}", "font": "=mono", "size": 20, "color": "=ink" },
        { "type": "text", "x": 220, "w": 352, "y": 224, "align": "center", "visible": "=empty", "text": "{empty.hint}", "size": 15, "color": "=dim", "wrap": true },
        { "type": "image", "src": "{game.art}", "fallback": "=either(game.romIcon, game.icon, sys.icon)", "fit": "contain", "x": 228, "y": 86, "w": 156, "h": 186,
          "placeholder": "=face", "visible": "=!empty", "opacity": "=easeOut(progress(moved, 180))" },
        { "type": "text", "x": 392, "y": 88, "w": 189, "text": "{game.title}", "font": "=mono", "size": 23, "color": "=ink", "wrap": true, "maxLines": 3 },
        { "type": "text", "x": 392, "y": 178, "w": 189, "text": "{game.sub}", "size": 15, "color": "=dim", "wrap": true, "maxLines": 2 },
        { "type": "rect", "x": 228, "y": 278, "w": 342, "h": 1, "fill": "=sh", "visible": "=!empty" },
        { "type": "group", "x": 228, "y": 290, "w": 342, "h": 58, "layout": "row", "gap": 30, "visible": "=!empty", "children": [
          { "use": "fact", "with": { "label": "Plays", "value": "=either(game.plays, '0')" } },
          { "use": "fact", "with": { "label": "Last", "value": "=either(game.last, 'Never')" } },
          { "use": "fact", "with": { "label": "Time", "value": "=either(game.time, '0m')" } } ] },
        { "type": "group", "x": 228, "y": 350, "w": 342, "h": 44, "visible": "=game.achB > 0", "children": [
          { "type": "text", "text": "{game.achLabel}", "size": 14, "color": "=dim" },
          { "type": "rect", "y": 26, "w": 342, "h": 16, "fill": "=paper", "border": 1, "borderColor": "=ink" },
          { "type": "rect", "x": 2, "y": 28, "w": "=338 * game.achProgress", "h": 12, "fill": "=acc" } ] },
        { "use": "statusbar", "x": 40, "y": 412, "w": 560, "h": 32 }
      ],
      "bottom": [
        { "use": "wallpaper" },
        // the system's folder, open over the desktop
        { "use": "window", "x": 8, "y": 30, "w": 624, "h": 420, "with": { "title": "{sys.name}" } },
        // the address bar
        { "type": "group", "x": 16, "y": 62, "w": 608, "h": 26, "children": [
          { "type": "text", "x": 0, "y": 6, "text": "Address", "size": 14, "color": "=ink" },
          { "type": "group", "x": 62, "y": 0, "right": 0, "h": 24, "children": [
            { "use": "client" },
            { "type": "text", "x": 6, "y": 3, "text": "C:\\Games\\{sys.name}", "font": "=mono", "size": 14, "color": "=ink" } ] } ] },
        // the file area
        { "type": "rect", "x": 16, "y": 92, "w": 608, "h": 326, "fill": "=paper", "border": 2, "borderColor": "=ink" },
        { "type": "text", "x": 16, "w": 608, "y": 230, "align": "center", "visible": "=empty", "text": "This folder is empty.", "size": 17, "color": "=dim" },
        { "type": "list", "source": "games", "direction": "column", "x": 22, "y": 98, "w": 596, "h": 314,
          "itemW": 596, "itemH": 33, "gap": 1, "scrollMode": "edge", "clip": true,
          "item": {
            "type": "group", "w": 596, "h": 33,
            "children": [
              { "type": "rect", "fill": "=sel ? navy : '#00000000'" },
              { "type": "image", "src": "=either(item.romIcon, item.icon, sys.icon)", "fit": "pixelContain", "x": 6, "y": 5, "w": 24, "h": 24 },
              { "type": "text", "x": 36, "y": 7, "w": 350, "text": "{item.title}", "size": 15, "color": "=sel ? '#ffffff' : ink" },
              { "type": "text", "right": 10, "y": 7, "w": 180, "align": "right", "text": "=item.plays > 0 ? plural(item.plays, 'play') : ''", "size": 14, "color": "=sel ? '#ffffff' : sh" }
            ]
          } },
        // the folder's status bar
        { "type": "group", "x": 16, "y": 420, "w": 608, "h": 24, "children": [
          { "type": "rect", "fill": "=face" },
          { "type": "rect", "y": 0, "h": 1, "w": "100%", "fill": "=ink" },
          { "type": "text", "x": 8, "y": 4, "text": "=plural(count, 'game')", "size": 14, "color": "=ink" },
          { "type": "text", "right": 8, "y": 4, "w": 200, "align": "right", "text": "{cursor + 1} of {count}", "size": 14, "color": "=ink", "visible": "=!empty" } ] }
      ]
    },

    "launch": {
      "bottom": [
        { "use": "wallpaper" },
        // the progress dialog
        { "type": "group", "w": 480, "h": 172, "scale": "=0.9 + 0.1 * easeOutBack(progress(launch.t, 220))",
          "anchor": "center", "x": 320, "y": 240, "children": [
            { "use": "window", "w": 480, "h": 172, "with": { "title": "Starting..." } },
            { "type": "text", "x": 16, "y": 58, "w": 448, "text": "Loading {game.title}...", "font": "=mono", "size": 17, "color": "=ink" },
            { "type": "rect", "x": 16, "y": 98, "w": 448, "h": 26, "fill": "=paper", "border": 2, "borderColor": "=ink" },
            { "type": "list", "source": "range", "count": 30, "direction": "row", "scrollMode": "none", "x": 26, "y": 104, "w": 440, "h": 18,
              "itemW": 12, "gap": 2,
              "item": { "type": "rect", "w": 12, "h": 18, "visible": "=i < floor(easeInOut(launch.progress) * 31)", "fill": "=acc" } },
            { "type": "text", "x": 16, "y": 136, "text": "{floor(launch.progress * 100)}%", "size": 14, "color": "=dim" }
          ] }
      ]
    }
  }
}