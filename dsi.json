{
  // DSi Menu: the Nintendo DSi's white menu, laid out at its own 256x192 proportions (x2.5) and drawn with the
  // handheld's low-resolution look: white pinstriped screens, the photo frame, the white title bubble, the row of
  // app tiles with START under the selection, and the silver page bar with its blue arrows.
  //
  // The pinstriped backgrounds, the L/R tabs and the volume icon are TWiLightMenu++'s "Default White" DSi skin
  // (DS-Homebrew / RocketRobz, GPL-3.0), upscaled from 256x192; the frame, bubble, tiles and page bar are drawn to
  // the same proportions.
  "name": "DSi Menu",
  "author": "BananaOS themes",
  "base": "light",
  "accent": "#3f74c9",
  "colors": {
    "screenBg": "#f2f2f2",
    "ink": "#333333",
    "muted": "#777777",
    "panel": "#ffffff"
  },
  "fonts": {
    "regular": "pixel",
    "medium": "pixel-medium"
  },
  "font": "pixel",

  "vars": {
    "blue": "#3f74c9",
    "ink": "#333333",
    "grey": "#8a8a8a",
    "line": "#c8c8c8",
    "white": "#ffffff",
    "hi": "#3f74c9"
  },

  "input": {
    "home": { "up": "prev", "down": "next", "l": "prev", "r": "next" },
    "library": { "up": "prev", "down": "next", "l": "prev", "r": "next" }
  },

  "behavior": { "launchMs": 950, "scrollMs": 60, "settleMs": 500, "cues": { "insert": 430 } },

  "components": {
    // the DSi's top bar: volume, the user's name in blue, the date and time, the battery
    "bar": {
      "type": "group", "x": 0, "y": 0, "w": "100%", "h": 48,
      "children": [
        { "type": "image", "src": "dsi/volume.png", "fit": "pixel", "x": 10, "y": 10, "w": 36, "h": 24 },
        { "type": "text", "x": 56, "y": 8, "text": "Banana", "size": 24, "color": "=blue" },
        { "type": "text", "right": 60, "y": 10, "w": 250, "align": "right", "text": "{date}  {clock}", "size": 20,
          "color": "=ink" },
        { "type": "rect", "right": 7, "y": 12, "w": 45, "h": 27, "radius": 5, "fill": "=white",
          "border": 2, "borderColor": "=grey", "visible": "=battery >= 0" },
        { "type": "rect", "right": 11, "y": 16, "w": "=36 * battery / 100", "h": 19, "radius": 3, "fill": "=blue",
          "visible": "=battery >= 0" },
        { "type": "rect", "right": 3, "y": 19, "w": 4, "h": 13, "radius": 2, "fill": "=grey", "visible": "=battery >= 0" }
      ]
    },

    // the L and R tabs of the DSi's top screen
    "shoulders": {
      "type": "group", "x": 0, "y": 430, "w": 640, "h": 50,
      "children": [
        { "type": "image", "src": "dsi/shoulder-l.png", "fit": "pixel", "x": 0, "y": 0, "w": 195, "h": 50 },
        { "type": "text", "x": 54, "y": 10, "text": "Previous", "size": 24, "color": "=ink" },
        { "type": "image", "src": "dsi/shoulder-r.png", "fit": "pixel", "right": 0, "y": 0, "w": 195, "h": 50 },
        { "type": "text", "right": 54, "y": 10, "w": 220, "align": "right", "text": "Next", "size": 24, "color": "=ink" }
      ]
    },

    // the silver page bar at the bottom of the lower screen: the dotted line, the blue arrows, the page thumb
    "pagebar": {
      "type": "group", "x": 0, "y": 410, "w": 640, "h": 70,
      "children": [
        { "type": "rect", "x": 0, "y": 0, "w": 640, "h": 70,
          "gradient": { "angle": 180, "stops": [ "#f4f4f4", "#c6c6c6" ] } },
        { "type": "rect", "x": 0, "y": 0, "w": 640, "h": 3, "fill": "#a8a8a8" },
        { "type": "rect", "x": 0, "y": 67, "w": 640, "h": 3, "fill": "#909090" },
        { "type": "list", "source": "range", "count": 34, "direction": "row", "x": 58, "y": 43, "w": 524, "h": 6,
          "stepX": 16, "scrollMode": "none",
          "item": { "type": "rect", "w": 6, "h": 5, "fill": "#7f9db8" } },
        { "type": "rect", "x": 6, "y": 12, "w": 44, "h": 46, "radius": 6, "fill": "=blue" },
        { "type": "text", "x": 6, "w": 44, "y": 18, "align": "center", "text": "<", "size": 28, "color": "=white" },
        { "type": "rect", "right": 6, "y": 12, "w": 44, "h": 46, "radius": 6, "fill": "=blue" },
        { "type": "text", "right": 6, "w": 44, "y": 18, "align": "center", "text": ">", "size": 28, "color": "=white" },
        { "type": "rect", "y": 12, "w": 92, "h": 46, "radius": 5, "fill": "=white", "border": 2, "borderColor": "=grey",
          "x": "=56 + 436 * (count > 1 ? cursor / (count - 1) : 0)" },
        { "type": "text", "y": 20, "w": 92, "h": 28, "align": "center", "text": "{cursor + 1} / {count}", "size": 18,
          "color": "=blue", "x": "=56 + 436 * (count > 1 ? cursor / (count - 1) : 0)" }
      ]
    },

    // one app tile: white with a silver edge, or the blue selected tile with START under the icon
    "tile": {
      "type": "group", "w": 120, "h": 150,
      "children": [
        { "type": "rect", "w": 120, "h": 150, "radius": 6, "visible": "=sel",
          "fill": "#7fa9d2", "gradient": { "angle": 180, "stops": [ "#a9cbe8", "#6f9fd0" ] },
          "border": 4, "borderColor": "=hi" },
        { "type": "rect", "w": 120, "h": 150, "radius": 6, "visible": "=!sel",
          "fill": "#fdfdfd", "border": 4, "borderColor": "#b4b4b4" },
        { "type": "rect", "x": 8, "y": 8, "w": 104, "h": 100, "radius": 4, "fill": "=white",
          "border": "=sel ? 0 : 2", "borderColor": "#c8c8c8" },
        { "type": "text", "x": 0, "y": 120, "w": 120, "align": "center", "text": "START", "size": 19, "color": "=white",
          "visible": "=sel" }
      ]
    }
  },

  "screens": {
    "home": {
      "top": [
        { "type": "image", "src": "dsi/bg-top.png", "fit": "pixel", "x": 0, "y": 0, "w": 640, "h": 480 },
        { "use": "bar" },
        { "type": "image", "src": "dsi/frame.png", "fit": "pixel", "x": 50, "y": 48, "w": 540, "h": 410 },
        { "type": "image", "src": "{sys.icon}", "fit": "pixelContain", "x": 320, "y": 253, "w": 222, "h": 222,
          "anchor": "center" },
        { "use": "shoulders" }
      ],
      "bottom": [
        { "type": "image", "src": "dsi/bg-bottom.png", "fit": "pixel", "x": 0, "y": 0, "w": 640, "h": 480 },

        { "type": "image", "src": "dsi/bubble.png", "fit": "pixel", "x": 20, "y": 18, "w": 600, "h": 195 },
        { "type": "text", "x": 0, "w": "100%", "y": 44, "align": "center", "text": "{sys.name}", "size": 36,
          "color": "=ink" },
        { "type": "text", "x": 0, "w": "100%", "y": 108, "align": "center", "text": "{upper(sys.maker)}", "size": 19,
          "color": "#6a6a6a" },

        { "type": "list", "source": "systems", "direction": "row", "x": 0, "y": 222, "w": 640, "h": 180,
          "itemW": 128, "itemH": 180, "stepX": 134, "scrollMode": "center",
          "item": {
            "type": "group", "w": 128, "h": 180,
            "children": [
              { "use": "tile", "x": 4, "y": 6 },
              { "type": "image", "src": "{item.icon}", "fit": "pixelContain", "x": 64, "y": 62, "w": 68, "h": 68,
                "anchor": "center", "opacity": "=sel ? 1 : 0.9" }
            ]
          } },

        { "use": "pagebar" }
      ]
    },

    "library": {
      "top": [
        { "type": "image", "src": "dsi/bg-top.png", "fit": "pixel", "x": 0, "y": 0, "w": 640, "h": 480 },
        { "use": "bar" },
        { "type": "image", "src": "dsi/frame.png", "fit": "pixel", "x": 50, "y": 48, "w": 540, "h": 410 },
        { "type": "image", "src": "{game.box}", "fit": "contain", "x": 320, "y": 253, "w": 210, "h": 350,
          "anchor": "center", "visible": "=game.box != ''" },
        { "type": "image", "src": "{game.art}", "fallback": "{sys.icon}", "fit": "contain", "x": 320, "y": 253,
          "w": 210, "h": 330, "anchor": "center", "visible": "=game.box == ''" },
        { "use": "shoulders" }
      ],
      "bottom": [
        { "type": "image", "src": "dsi/bg-bottom.png", "fit": "pixel", "x": 0, "y": 0, "w": 640, "h": 480 },

        { "type": "image", "src": "dsi/bubble.png", "fit": "pixel", "x": 20, "y": 18, "w": 600, "h": 195 },
        { "type": "text", "x": 0, "w": "100%", "y": 42, "align": "center", "text": "{game.title}", "size": 34,
          "color": "=ink", "wrap": false, "ellipsis": true },
        { "type": "text", "x": 0, "w": "100%", "y": 108, "align": "center",
          "text": "{sys.name}  -  {game.plays} {game.plays == 1 ? 'play' : 'plays'}", "size": 19, "color": "#6a6a6a" },

        { "type": "text", "x": 0, "w": "100%", "y": 250, "align": "center", "text": "{empty.title}", "size": 28,
          "color": "=ink", "visible": "=empty" },
        { "type": "text", "x": 40, "w": 560, "y": 290, "align": "center", "text": "{empty.hint}", "size": 18,
          "color": "#6a6a6a", "wrap": true, "visible": "=empty" },

        { "type": "list", "source": "games", "direction": "row", "x": 0, "y": 222, "w": 640, "h": 180,
          "itemW": 128, "itemH": 180, "stepX": 134, "scrollMode": "center",
          "item": {
            "type": "group", "w": 128, "h": 180,
            "children": [
              { "use": "tile", "x": 4, "y": 6 },
              { "type": "image", "src": "{item.art}", "fallback": "{item.icon}", "fit": "cover", "x": 64, "y": 62,
                "w": 68, "h": 68, "anchor": "center", "radius": 2, "placeholder": "#dfe6ee",
                "opacity": "=sel ? 1 : 0.9" }
            ]
          } },

        { "use": "pagebar" }
      ]
    },

    "launch": {
      "top": [
        { "type": "rect", "fill": "#ffffff" },
        { "type": "image", "src": "{game.box}", "fit": "contain", "x": 320, "y": 240, "w": 260, "h": 360,
          "anchor": "center", "visible": "=game.box != ''",
          "scale": "=1 + 0.9 * easeIn(launch.progress)", "opacity": "=1 - easeIn(launch.progress)" },
        { "type": "image", "src": "{game.art}", "fallback": "{sys.icon}", "fit": "contain", "x": 320, "y": 240,
          "w": 240, "h": 330, "anchor": "center", "visible": "=game.box == ''",
          "scale": "=1 + 0.9 * easeIn(launch.progress)", "opacity": "=1 - easeIn(launch.progress)" },
        { "type": "rect", "fill": "#ffffff", "opacity": "=easeIn(launch.progress) * 0.92" }
      ],
      "bottom": [
        { "type": "rect", "fill": "#ffffff" },
        { "type": "image", "src": "{sys.icon}", "fit": "pixelContain", "x": 320, "y": 150, "w": 110, "h": 110,
          "anchor": "center", "opacity": "=1 - easeIn(launch.progress)" },
        { "type": "text", "x": 0, "w": "100%", "y": 226, "align": "center", "text": "{game.title}", "size": 30,
          "color": "=ink" },
        { "type": "rect", "x": 200, "y": 300, "w": 240, "h": 14, "radius": 3, "fill": "=white", "border": 3,
          "borderColor": "=blue" },
        { "type": "rect", "x": 203, "y": 303, "w": "=234 * easeInOut(launch.progress)", "h": 8, "radius": 2, "fill": "=blue" }
      ]
    }
  }
}
