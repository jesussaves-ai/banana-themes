{
  // DSi Menu: the Nintendo DSi's app menu. The two screens are the DSi's own: the top one a box art in its white
  // frame over the striped blue, the L and R tabs along its bottom; the bottom one the white speech bubble with the
  // title and maker, the row of app tiles with START under the selection, and the page bar along the bottom.
  // The striped backgrounds, the title bubble, the shoulder tabs, the volume icon and the palette are
  // TWiLightMenu++'s "Default Blue" DSi skin (DS-Homebrew, GPL-3.0); the rest is drawn by BananaOS's elements.
  "name": "DSi Menu",
  "author": "BananaOS themes",
  "base": "light",
  "accent": "#2f55f0",
  "colors": {
    "screenBg": "#eef4ff",
    "ink": "#20304a",
    "muted": "#66748a",
    "panel": "#ffffff"
  },
  "fonts": {
    "regular": "dsi/VarelaRound-Regular.ttf",
    "medium": "dsi/VarelaRound-Regular.ttf",
    "round": "dsi/VarelaRound-Regular.ttf"
  },
  "font": "round",

  "vars": {
    "blue": "#3a4fe0",
    "deep": "#20304a",
    "soft": "#54648a",
    "teal": "#a8d0c8",
    "white": "#ffffff",
    "hi": "#2f55f0"
  },

  "input": {
    "home": { "up": "prev", "down": "next", "l": "prev", "r": "next" },
    "library": { "up": "prev", "down": "next", "l": "prev", "r": "next" }
  },

  "behavior": { "launchMs": 950, "scrollMs": 90, "settleMs": 700, "cues": { "insert": 430 } },

  "components": {
    // the top screen's bar: the volume, the date and clock, the battery
    "bar": {
      "type": "group", "x": 0, "y": 0, "w": "100%", "h": 46,
      "children": [
        { "type": "image", "src": "dsi/volume.png", "fit": "pixel", "x": 16, "y": 9, "w": 36, "h": 24 },
        { "type": "text", "right": 68, "y": 10, "w": 240, "align": "right", "text": "{date}   {clock}", "size": 18,
          "color": "=white", "shadow": { "y": 1, "color": "#243a8a88" } },
        { "type": "rect", "right": 18, "y": 12, "w": 42, "h": 21, "radius": 4, "fill": "=white", "visible": "=battery >= 0" },
        { "type": "rect", "right": 21, "y": 15, "w": "=36 * battery / 100", "h": 15, "radius": 2, "fill": "=hi",
          "visible": "=battery >= 0" },
        { "type": "rect", "right": 12, "y": 17, "w": 4, "h": 11, "radius": 1, "fill": "=white", "visible": "=battery >= 0" }
      ]
    },

    // the DSi's white frame over the striped blue, the teal matte inside
    "frame": {
      "type": "group", "x": 24, "y": 48, "w": 592, "h": 366,
      "children": [
        { "type": "rect", "x": 0, "y": 0, "w": 592, "h": 366, "radius": 7, "fill": "=white",
          "border": 3, "borderColor": "=blue", "shadow": { "y": 3, "blur": 8, "color": "#1a2f8a55" } },
        { "type": "rect", "x": 16, "y": 16, "w": 560, "h": 334, "radius": 2, "fill": "=teal" }
      ]
    },

    // the L and R tabs of the DSi's top screen
    "shoulders": {
      "type": "group", "x": 0, "y": 428, "w": 640, "h": 52,
      "children": [
        { "type": "image", "src": "dsi/shoulder-l.png", "fit": "pixel", "x": 0, "y": 0, "w": 195, "h": 50 },
        { "type": "text", "x": 56, "y": 9, "text": "Previous", "size": 22, "color": "=white", "opacity": 0.88 },
        { "type": "image", "src": "dsi/shoulder-r.png", "fit": "pixel", "right": 0, "y": 0, "w": 195, "h": 50 },
        { "type": "text", "right": 56, "y": 9, "w": 200, "align": "right", "text": "Next", "size": 22, "color": "=white",
          "opacity": 0.88 }
      ]
    },

    // the page bar: the blue strip, its end arrows, the thumb
    "pagebar": {
      "type": "group", "x": 0, "y": 440, "w": 640, "h": 40,
      "children": [
        { "type": "rect", "x": 0, "y": 0, "w": 640, "h": 40, "fill": "#5a70ea" },
        { "type": "rect", "x": 0, "y": 0, "w": 640, "h": 2, "fill": "=blue" },
        { "type": "rect", "x": 0, "y": 0, "w": 46, "h": 40, "fill": "#4257dd" },
        { "type": "text", "x": 0, "w": 46, "y": 7, "align": "center", "text": "‹", "size": 24, "color": "=white" },
        { "type": "rect", "right": 0, "y": 0, "w": 46, "h": 40, "fill": "#4257dd" },
        { "type": "text", "right": 0, "w": 46, "y": 7, "align": "center", "text": "›", "size": 24, "color": "=white" },
        { "type": "rect", "y": 6, "h": 28, "radius": 5, "fill": "#2f47c8", "w": 120,
          "x": "=46 + 428 * (count > 1 ? cursor / (count - 1) : 0)" },
        { "type": "text", "y": 10, "h": 22, "w": 120, "align": "center", "text": "{cursor + 1} / {count}", "size": 13,
          "color": "=white", "opacity": 0.9, "x": "=46 + 428 * (count > 1 ? cursor / (count - 1) : 0)" }
      ]
    },

    // one app tile: the white square, the icon, START under the selection
    "tile": {
      "type": "group", "w": 120, "h": 140,
      "children": [
        { "type": "rect", "w": 120, "h": 140, "radius": 8, "fill": "=white",
          "border": "=sel ? 4 : 2", "borderColor": "=sel ? hi : '#93a3c4'",
          "shadow": { "y": 3, "blur": 7, "color": "#1a2f8a44" } },
        { "type": "rect", "x": 8, "y": 8, "w": 104, "h": 100, "radius": 5, "fill": "#eef3fb",
          "border": 1, "borderColor": "#b9c4d8" },
        { "type": "rect", "x": 2, "y": 110, "w": 116, "h": 28, "radius": [ 0, 0, 6, 6 ], "fill": "=hi", "visible": "=sel" },
        { "type": "text", "x": 2, "y": 114, "w": 116, "align": "center", "text": "START", "size": 16, "color": "=white",
          "visible": "=sel" }
      ]
    }
  },

  "screens": {
    "home": {
      "top": [
        { "type": "image", "src": "dsi/bg-top.png", "fit": "pixel", "x": 0, "y": 0, "w": 640, "h": 480 },
        { "use": "bar" },
        { "use": "frame" },
        { "type": "image", "src": "{sys.icon}", "fit": "pixelContain", "x": 320, "y": 231, "w": 212, "h": 212,
          "anchor": "center", "scale": "=0.94 + 0.06 * easeOut(progress(moved, 260))" },
        { "use": "shoulders" }
      ],
      "bottom": [
        { "type": "image", "src": "dsi/bg-bottom.png", "fit": "pixel", "x": 0, "y": 0, "w": 640, "h": 480 },

        { "type": "text", "x": 0, "w": "100%", "y": 88, "align": "center", "text": "{sys.name}", "size": 32,
          "color": "=deep" },
        { "type": "text", "x": 0, "w": "100%", "y": 138, "align": "center", "text": "{upper(sys.maker)}", "size": 16,
          "color": "#54648a" },

        { "type": "list", "source": "systems", "direction": "row", "x": 0, "y": 270, "w": 640, "h": 160,
          "itemW": 128, "itemH": 160, "stepX": 134, "scrollMode": "center",
          "item": {
            "type": "group", "w": 128, "h": 160,
            "children": [
              { "use": "tile", "x": 4, "y": 10 },
              { "type": "image", "src": "{item.icon}", "fit": "pixelContain", "x": 64, "y": 62, "w": 70, "h": 70,
                "anchor": "center", "opacity": "=sel ? 1 : 0.85" }
            ]
          } },

        { "use": "pagebar" }
      ]
    },

    "library": {
      "top": [
        { "type": "image", "src": "dsi/bg-top.png", "fit": "pixel", "x": 0, "y": 0, "w": 640, "h": 480 },
        { "use": "bar" },
        { "use": "frame" },
        { "type": "image", "src": "{game.box}", "fit": "contain", "x": 320, "y": 231, "w": 200, "h": 320,
          "anchor": "center", "radius": 2, "visible": "=game.box != ''",
          "scale": "=0.96 + 0.04 * easeOut(progress(moved, 260))" },
        { "type": "image", "src": "{game.art}", "fallback": "{sys.icon}", "fit": "contain", "x": 320, "y": 231,
          "w": 200, "h": 300, "anchor": "center", "radius": 2, "visible": "=game.box == ''",
          "scale": "=0.96 + 0.04 * easeOut(progress(moved, 260))" },
        { "use": "shoulders" }
      ],
      "bottom": [
        { "type": "image", "src": "dsi/bg-bottom.png", "fit": "pixel", "x": 0, "y": 0, "w": 640, "h": 480 },

        { "type": "text", "x": 0, "w": "100%", "y": 86, "align": "center", "text": "{game.title}", "size": 32,
          "color": "=deep", "wrap": false, "ellipsis": true },
        { "type": "text", "x": 0, "w": "100%", "y": 136, "align": "center",
          "text": "{sys.name}   ·   {game.plays} {game.plays == 1 ? 'play' : 'plays'}", "size": 15, "color": "#54648a" },

        { "type": "text", "x": 0, "w": "100%", "y": 206, "align": "center", "text": "{empty.title}", "size": 24,
          "color": "=deep", "visible": "=empty" },
        { "type": "text", "x": 40, "w": 560, "y": 244, "align": "center", "text": "{empty.hint}", "size": 14,
          "color": "=soft", "wrap": true, "visible": "=empty" },

        { "type": "list", "source": "games", "direction": "row", "x": 0, "y": 270, "w": 640, "h": 160,
          "itemW": 128, "itemH": 160, "stepX": 134, "scrollMode": "center",
          "item": {
            "type": "group", "w": 128, "h": 160,
            "children": [
              { "use": "tile", "x": 4, "y": 10 },
              { "type": "image", "src": "{item.art}", "fallback": "{item.icon}", "fit": "cover", "x": 64, "y": 62,
                "w": 70, "h": 70, "anchor": "center", "radius": 4, "placeholder": "#cfd8e8",
                "opacity": "=sel ? 1 : 0.85" }
            ]
          } },

        { "use": "pagebar" }
      ]
    },

    "launch": {
      "top": [
        { "type": "rect", "fill": "#ffffff" },
        { "type": "image", "src": "{game.box}", "fit": "contain", "x": 320, "y": 240, "w": 240, "h": 320,
          "anchor": "center", "radius": 3, "visible": "=game.box != ''",
          "scale": "=1 + 0.9 * easeIn(launch.progress)", "opacity": "=1 - easeIn(launch.progress)" },
        { "type": "image", "src": "{game.art}", "fallback": "{sys.icon}", "fit": "contain", "x": 320, "y": 240,
          "w": 220, "h": 300, "anchor": "center", "radius": 3, "visible": "=game.box == ''",
          "scale": "=1 + 0.9 * easeIn(launch.progress)", "opacity": "=1 - easeIn(launch.progress)" },
        { "type": "rect", "fill": "#ffffff", "opacity": "=easeIn(launch.progress) * 0.92" }
      ],
      "bottom": [
        { "type": "image", "src": "dsi/bg-bottom.png", "fit": "pixel", "x": 0, "y": 0, "w": 640, "h": 480 },
        { "type": "image", "src": "{sys.icon}", "fit": "pixelContain", "x": 320, "y": 140, "w": 92, "h": 92,
          "anchor": "center", "opacity": "=0.9 - 0.5 * easeIn(launch.progress)" },
        { "type": "text", "x": 0, "w": "100%", "y": 200, "align": "center", "text": "{game.title}", "size": 22,
          "color": "=deep" },
        { "type": "rect", "x": 220, "y": 260, "w": 200, "h": 10, "radius": 5, "fill": "=white", "border": 2,
          "borderColor": "=blue" },
        { "type": "rect", "x": 222, "y": 262, "w": "=196 * easeInOut(launch.progress)", "h": 6, "radius": 3, "fill": "=hi" }
      ]
    }
  }
}
